{
  "UseHttpsRedirect": false,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Multitenancy": {
    "Enabled": false,
    "DefaultSubdomain": "default"
  },
  "DevData": {
    "EnableSeeding": true
  },
  "SystemAdminBootstrap": {
    "Enabled": false
  },
  "SingleTenantBootstrap": {
    "Enabled": true,
    "ConventionName": "Conclave",
    "ConventionSlug": "conclave",
    "AdminName": "Admin"
  },
  "Email": {
    "Provider": "Outbox",
    "OutboxBackend": "SendGrid",
    "FromName": "Conclave"
  },
  "App": {
    "FrontendUrl": "https://your-app.azurewebsites.net",
    "AdminUrlTemplate": "https://your-app.azurewebsites.net/admin",
    "PortalUrl": "https://your-app.azurewebsites.net/portal",
    "ReceptionUrl": "https://your-app.azurewebsites.net/reception"
  }
}
